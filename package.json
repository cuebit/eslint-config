{
  "name": "@cuebit/eslint-config",
  "type": "module",
  "version": "5.0.0",
  "packageManager": "pnpm@11.18.0",
  "description": "Opinionated ESLint config",
  "author": "Cue <hello@cuebit.dev>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/cuebit",
  "homepage": "https://github.com/cuebit/eslint-config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuebit/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/cuebit/eslint-config/issues"
  },
  "keywords": [
    "eslint-config"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --clean --dts",
    "dev": "tsdown --watch & pnpm dlx @eslint/config-inspector",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepack": "pnpm build",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "eslint": "catalog:"
  },
  "dependencies": {
    "@antfu/eslint-config": "catalog:",
    "defu": "catalog:",
    "eslint-flat-config-utils": "catalog:"
  },
  "devDependencies": {
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "lint-staged": "catalog:",
    "simple-git-hooks": "catalog:",
    "tsdown": "catalog:",
    "tsdown-stale-guard": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
